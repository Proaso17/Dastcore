<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{% if target %} — {{ target }}{% endif %}</title>
<style>
  :root {
    --bg: #0f1420; --panel: #1a2130; --panel-2: #141a26; --text: #e6e9ef;
    --muted: #9aa4b2; --border: #2a3446; --accent: #4da3ff;
    --critical: #ff4d6d; --high: #ff784e; --medium: #ffc247; --low: #4da3ff; --info: #8b95a5;
    --fix: #35d0a5; --fix-soft: rgba(53,208,165,.12); --fix-border: rgba(53,208,165,.4);
    --bad: #ff6b81; --bad-soft: rgba(255,77,109,.09); --bad-border: rgba(255,77,109,.35);
    --good: #35d0a5; --good-soft: rgba(53,208,165,.09); --good-border: rgba(53,208,165,.35);
  }
  @media (prefers-color-scheme: light) {
    :root {
      --bg: #f5f7fa; --panel: #ffffff; --panel-2: #eef1f6; --text: #1a2130;
      --muted: #5b6472; --border: #d5dbe6; --accent: #1f6feb;
      --critical: #d1243b; --high: #c1440e; --medium: #9a6b00; --low: #1f6feb; --info: #5b6472;
      --fix: #0f9d76; --fix-soft: rgba(15,157,118,.08); --fix-border: rgba(15,157,118,.3);
      --bad: #c02338; --bad-soft: rgba(209,36,59,.06); --bad-border: rgba(209,36,59,.28);
      --good: #0f9d76; --good-soft: rgba(15,157,118,.07); --good-border: rgba(15,157,118,.3);
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.5; }
  .wrap { max-width: 1000px; margin: 0 auto; padding: 24px 20px 64px; }
  header h1 { margin: 0 0 4px; font-size: 24px; }
  header .meta { color: var(--muted); font-size: 13px; }
  .summary { display: flex; flex-wrap: wrap; gap: 10px; margin: 20px 0 28px; }
  .stat { background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
    padding: 10px 14px; min-width: 92px; }
  .stat .n { font-size: 22px; font-weight: 700; }
  .stat .l { font-size: 11px; text-transform: uppercase; letter-spacing: .5px; color: var(--muted); }
  .badge { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 11px;
    font-weight: 700; text-transform: uppercase; letter-spacing: .4px; color: #fff; }
  .b-critical { background: var(--critical); } .b-high { background: var(--high); }
  .b-medium { background: var(--medium); color: #23180a; } .b-low { background: var(--low); }
  .b-info { background: var(--info); }
  .dot-critical { color: var(--critical); } .dot-high { color: var(--high); }
  .dot-medium { color: var(--medium); } .dot-low { color: var(--low); } .dot-info { color: var(--info); }
  .finding { background: var(--panel); border: 1px solid var(--border); border-left-width: 4px;
    border-radius: 10px; padding: 16px 18px; margin-bottom: 16px; }
  .finding.sev-critical { border-left-color: var(--critical); }
  .finding.sev-high { border-left-color: var(--high); }
  .finding.sev-medium { border-left-color: var(--medium); }
  .finding.sev-low { border-left-color: var(--low); }
  .finding.sev-info { border-left-color: var(--info); }
  .finding h3 { margin: 0 0 8px; font-size: 17px; display: flex; align-items: center; gap: 10px; }
  .kv { display: grid; grid-template-columns: 130px 1fr; gap: 4px 12px; font-size: 13px; margin: 10px 0; }
  .kv dt { color: var(--muted); } .kv dd { margin: 0; word-break: break-word; }
  .section-label { font-size: 11px; text-transform: uppercase; letter-spacing: .5px;
    color: var(--muted); margin: 14px 0 4px; }
  pre { background: var(--panel-2); border: 1px solid var(--border); border-radius: 8px;
    padding: 10px 12px; overflow-x: auto; font-size: 12.5px; margin: 0;
    font-family: "SF Mono", "Cascadia Code", Consolas, monospace; white-space: pre-wrap; word-break: break-word; }
  .evidence { list-style: none; padding: 0; margin: 4px 0 0; }
  .evidence li { font-size: 13px; padding: 6px 10px; background: var(--panel-2);
    border: 1px solid var(--border); border-radius: 8px; margin-bottom: 6px; }
  .evidence .etype { font-weight: 700; color: var(--accent); }
  /* --- How to fix panel ------------------------------------------------------ */
  .fix { margin-top: 8px; border: 1px solid var(--fix-border); border-radius: 12px;
    background: var(--fix-soft); overflow: hidden; }
  .fix-head { display: flex; align-items: center; gap: 9px; padding: 10px 14px;
    background: linear-gradient(90deg, var(--fix-soft), transparent);
    border-bottom: 1px solid var(--fix-border); }
  .fix-head .ico { flex: none; width: 26px; height: 26px; border-radius: 7px;
    display: grid; place-items: center; background: var(--fix); color: #06231b; }
  .fix-head .ico svg { width: 15px; height: 15px; }
  .fix-head .t { font-weight: 700; font-size: 14px; letter-spacing: .2px; }
  .fix-body { padding: 12px 14px 14px; }
  .fix-summary { font-size: 13.5px; margin: 0 0 8px; }
  ol.fix-steps { margin: 4px 0 0; padding-left: 0; list-style: none; counter-reset: step; }
  ol.fix-steps li { position: relative; padding: 4px 0 4px 30px; font-size: 13px;
    counter-increment: step; }
  ol.fix-steps li::before { content: counter(step); position: absolute; left: 0; top: 3px;
    width: 20px; height: 20px; border-radius: 50%; background: var(--fix); color: #06231b;
    font-size: 11px; font-weight: 700; display: grid; place-items: center; }
  .code-compare { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 12px 0 4px; }
  @media (max-width: 620px) { .code-compare { grid-template-columns: 1fr; } }
  .code-col { border-radius: 8px; overflow: hidden; border: 1px solid var(--border); }
  .code-col .tag { font-size: 10.5px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .5px; padding: 5px 10px; display: flex; align-items: center; gap: 6px; }
  .code-col.bad { border-color: var(--bad-border); }
  .code-col.bad .tag { background: var(--bad-soft); color: var(--bad); }
  .code-col.good { border-color: var(--good-border); }
  .code-col.good .tag { background: var(--good-soft); color: var(--good); }
  .code-col pre { border: none; border-radius: 0; background: var(--panel-2); }
  .code-note { font-size: 12px; color: var(--muted); margin: 8px 0 0; font-style: italic; }
  .refs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .refs a { font-size: 12px; text-decoration: none; color: var(--accent);
    border: 1px solid var(--border); background: var(--panel-2); border-radius: 999px;
    padding: 4px 11px; transition: border-color .15s; }
  .refs a:hover { border-color: var(--accent); }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  @media (prefers-reduced-motion: reduce) { * { transition-duration: .001ms !important; } }
  .empty { text-align: center; color: var(--muted); padding: 48px 0; }
  code { font-family: "SF Mono", "Cascadia Code", Consolas, monospace; font-size: 12.5px; }
  footer { color: var(--muted); font-size: 12px; margin-top: 32px; text-align: center; }
  h2.category { font-size: 15px; margin: 26px 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--border); }
  h2.category .count { color: var(--muted); font-weight: 400; font-size: 13px; }
  pre.repro { border-left: 3px solid var(--accent); }
  table.issues { width: 100%; border-collapse: collapse; margin: 18px 0 8px; font-size: 13px; }
  table.issues th { text-align: left; color: var(--muted); font-weight: 600; font-size: 11px;
    text-transform: uppercase; letter-spacing: .5px; padding: 6px 10px; border-bottom: 1px solid var(--border); }
  table.issues td { padding: 8px 10px; border-bottom: 1px solid var(--border); }
  table.issues td.num { text-align: right; font-weight: 700; }
  table.issues .rid { color: var(--muted); font-size: 11px; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>{{ title }}</h1>
    <div class="meta">
      {% if target %}Target: <code>{{ target }}</code> · {% endif %}
      Generated {{ generated_at }} · dastcore v{{ version }}
    </div>
  </header>

  <section class="summary">
    <div class="stat"><div class="n">{{ total }}</div><div class="l">Total</div></div>
    <div class="stat"><div class="n">{{ issues|length }}</div><div class="l">Issues</div></div>
    {% for sev in severity_order %}
    <div class="stat">
      <div class="n dot-{{ sev }}">{{ counts[sev] }}</div>
      <div class="l">{{ sev }}</div>
    </div>
    {% endfor %}
  </section>

  {% if issues %}
  <table class="issues">
    <thead><tr><th>Severidad</th><th>CVSS</th><th>Confianza</th><th>Issue</th><th>CWE / OWASP</th><th>Instancias</th></tr></thead>
    <tbody>
    {% for issue in issues %}
      <tr>
        <td><span class="badge b-{{ issue.severity }}">{{ issue.severity }}</span></td>
        <td class="num">{{ "%.1f"|format(issue.cvss_score) }}</td>
        <td>{{ issue.confidence }}</td>
        <td>{{ issue.name }} <code class="rid">{{ issue.rule_id }}</code></td>
        <td>{{ issue.cwe }} · {{ issue.owasp }}</td>
        <td class="num">{{ issue.count }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% macro finding_card(f) %}
    <article class="finding sev-{{ f.severity }}">
      <h3>
        <span class="badge b-{{ f.severity }}">{{ f.severity }}</span>
        {{ f.name }}
      </h3>
      <dl class="kv">
        <dt>Rule</dt><dd><code>{{ f.rule_id }}</code></dd>
        <dt>CVSS</dt><dd><strong>{{ "%.1f"|format(f.cvss_score) }}</strong> <code>{{ f.cvss_vector }}</code></dd>
        <dt>Confianza</dt><dd><strong>{{ f.confidence }}</strong> ({{ "%.2f"|format(f.confidence_score) }})</dd>
        {% if f.corroborated_by %}<dt>Corroborado por</dt><dd>{{ f.corroborated_by | join(", ") }}</dd>{% endif %}
        <dt>CWE</dt><dd>{{ f.cwe }}</dd>
        <dt>OWASP</dt><dd>{{ f.owasp }}</dd>
        <dt>Injection point</dt>
        <dd><code>{{ f.injection_point.location }}</code> parameter <code>{{ f.injection_point.name }}</code></dd>
        <dt>Finding id</dt><dd><code>{{ f.id }}</code></dd>
      </dl>

      <div class="section-label">Evidence</div>
      <ul class="evidence">
        {% for ev in f.evidence %}
        <li><span class="etype">{{ ev.type }}</span> ({{ ev.confidence }}) — {{ ev.data }}</li>
        {% else %}
        <li>No evidence recorded.</li>
        {% endfor %}
      </ul>

      <div class="section-label">Request</div>
      <pre>{{ f.request.method }} {{ f.request.url }}
{%- if f.request.params %}
params: {{ f.request.params }}
{%- endif %}
{%- if f.request.data %}
body: {{ f.request.data }}
{%- endif %}
{%- if f.request.json_body %}
json: {{ f.request.json_body }}
{%- endif %}</pre>

      <div class="section-label">Response</div>
      <pre>HTTP {{ f.response.status_code }} · {{ "%.0f"|format(f.response.elapsed_ms) }} ms
{{ f.response.text | truncate(800, true, "…") }}</pre>

      <div class="section-label">Reproducir (curl)</div>
      <pre class="repro">{{ f.repro_curl }}</pre>

      {% set g = remediation_guide(f) %}
      <div class="fix">
        <div class="fix-head">
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z"/>
            </svg>
          </span>
          <span class="t">How to fix</span>
        </div>
        <div class="fix-body">
          <p class="fix-summary">{{ g.summary }}</p>
          {% if g.steps %}
          <ol class="fix-steps">
            {% for step in g.steps %}<li>{{ step }}</li>{% endfor %}
          </ol>
          {% endif %}
          {% if g.example %}
          <div class="code-compare">
            <div class="code-col bad">
              <div class="tag">✗ Vulnerable</div>
              <pre>{{ g.example.bad }}</pre>
            </div>
            <div class="code-col good">
              <div class="tag">✓ Secure</div>
              <pre>{{ g.example.good }}</pre>
            </div>
          </div>
          {% if g.example.note %}<p class="code-note">{{ g.example.note }}</p>{% endif %}
          {% endif %}
          {% if g.references %}
          <div class="refs">
            {% for ref in g.references %}
            <a href="{{ ref.url }}" target="_blank" rel="noopener noreferrer">{{ ref.label }} ↗</a>
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </div>
    </article>
  {% endmacro %}

  {% if not findings %}
    <div class="empty">No findings. Nothing at or above the reporting bar was confirmed.</div>
  {% elif grouped %}
    {% for category, group in grouped %}
    <h2 class="category">{{ category }} <span class="count">{{ group|length }}</span></h2>
    {% for f in group %}{{ finding_card(f) }}{% endfor %}
    {% endfor %}
  {% else %}
    {% for f in findings %}{{ finding_card(f) }}{% endfor %}
  {% endif %}

  <footer>
    Generated by dastcore · Only scan systems you are authorized to test.
  </footer>
</div>
</body>
</html>
