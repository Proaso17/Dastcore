<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}dastcore{% endblock %}</title>
  <style>
    :root {
      --bg: #f6f7f9; --panel: #ffffff; --ink: #1a1d21; --muted: #667085;
      --border: #e4e7ec; --accent: #2f6fed; --accent-ink: #ffffff;
      --crit: #b42318; --high: #d92d20; --med: #b54708; --low: #026aa2; --info: #667085;
      --ok: #067647; --bad: #b42318;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #14171c; --panel: #1c2027; --ink: #e6e8eb; --muted: #98a2b3;
        --border: #2a2f38; --accent: #4b8bff; --accent-ink: #0b0e12;
        --crit: #ff6b5e; --high: #ff7a70; --med: #f5a623; --low: #4bb3e6; --info: #98a2b3;
        --ok: #4ac489; --bad: #ff6b5e;
      }
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--ink);
      font: 15px/1.5 -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    header.top { background: var(--panel); border-bottom: 1px solid var(--border); padding: 14px 22px;
      display: flex; align-items: baseline; gap: 14px; }
    header.top .brand { font-weight: 700; font-size: 18px; }
    header.top .tag { color: var(--muted); font-size: 13px; }
    main { max-width: 1080px; margin: 0 auto; padding: 22px; }
    .panel { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 18px 20px; margin-bottom: 20px; }
    .panel h2 { margin: 0 0 14px; font-size: 16px; }
    .legal { border-left: 3px solid var(--high); font-size: 13px; color: var(--muted); }
    label { display: block; font-size: 13px; color: var(--muted); margin: 10px 0 4px; }
    input, select { width: 100%; padding: 9px 10px; border: 1px solid var(--border); border-radius: 8px;
      background: var(--bg); color: var(--ink); font-size: 14px; }
    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .row3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }
    .check { display: flex; align-items: center; gap: 8px; margin: 16px 0; }
    .check input { width: auto; }
    button { background: var(--accent); color: var(--accent-ink); border: 0; border-radius: 8px;
      padding: 10px 18px; font-size: 14px; font-weight: 600; cursor: pointer; }
    button:hover { filter: brightness(1.05); }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th, td { text-align: left; padding: 9px 10px; border-bottom: 1px solid var(--border); }
    th { color: var(--muted); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
    .overflow { overflow-x: auto; }
    .badge { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 12px; font-weight: 700; color: #fff; }
    .sev-critical { background: var(--crit); } .sev-high { background: var(--high); }
    .sev-medium { background: var(--med); } .sev-low { background: var(--low); } .sev-info { background: var(--info); }
    .status { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
    .st-running { color: var(--accent); } .st-done { color: var(--ok); }
    .st-error, .st-interrupted { color: var(--bad); }
    .rt-open { color: var(--bad); font-weight: 700; } .rt-fixed { color: var(--ok); font-weight: 700; }
    .rt-unverified { color: var(--med); font-weight: 700; }
    .subform { margin-top: 16px; border-top: 1px solid var(--border); padding-top: 14px; }
    .muted { color: var(--muted); }
    .err { border-left: 3px solid var(--bad); color: var(--bad); }
    .progress { height: 10px; border-radius: 999px; background: var(--border); overflow: hidden; margin: 10px 0; }
    .progress > span { display: block; height: 100%; background: var(--accent); transition: width .3s ease; }
    .actions { display: flex; gap: 14px; margin-top: 12px; font-size: 14px; }
    .empty { color: var(--muted); font-style: italic; padding: 8px 0; }
    form.triage { display: flex; gap: 6px; margin: 0; }
    form.triage input { width: 120px; padding: 5px 7px; font-size: 12px; }
    form.triage button { padding: 5px 10px; font-size: 12px; }
    .accepted { margin-top: 18px; border-top: 1px dashed var(--border); padding-top: 12px; }
    code { background: var(--bg); border: 1px solid var(--border); border-radius: 5px; padding: 1px 5px; font-size: 13px; }
    button.danger { background: var(--bad); }
    /* --- "Cómo solucionarlo" (per-issue remediation guide) --- */
    tr.issue-row > td { border-bottom: none; }
    tr.fix-row > td { padding: 0 10px 12px; border-bottom: 1px solid var(--border); }
    details.fix { border: 1px solid var(--border); border-radius: 10px; background: var(--bg); overflow: hidden; }
    details.fix > summary { cursor: pointer; list-style: none; display: flex; align-items: center; gap: 8px;
      padding: 8px 12px; font-size: 13px; font-weight: 600; color: var(--ok); user-select: none; }
    details.fix > summary::-webkit-details-marker { display: none; }
    details.fix > summary:hover { background: color-mix(in srgb, var(--ok) 8%, transparent); }
    details.fix .wr { width: 15px; height: 15px; flex: none; }
    details.fix[open] > summary { border-bottom: 1px solid var(--border); }
    .fix-body { padding: 12px 14px 14px; }
    .fix-sum { margin: 0 0 8px; font-size: 13.5px; color: var(--ink); }
    ol.fix-steps { margin: 6px 0 0; padding: 0; list-style: none; counter-reset: step; }
    ol.fix-steps li { position: relative; padding: 4px 0 4px 28px; font-size: 13px; counter-increment: step; }
    ol.fix-steps li::before { content: counter(step); position: absolute; left: 0; top: 3px; width: 19px; height: 19px;
      border-radius: 50%; background: var(--ok); color: #fff; font-size: 11px; font-weight: 700;
      display: grid; place-items: center; }
    .code2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 12px 0 4px; }
    @media (max-width: 640px) { .code2 { grid-template-columns: 1fr; } }
    .cbox { border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
    .cbox.bad { border-color: color-mix(in srgb, var(--bad) 45%, var(--border)); }
    .cbox.good { border-color: color-mix(in srgb, var(--ok) 45%, var(--border)); }
    .ctag { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; padding: 5px 10px; }
    .cbox.bad .ctag { color: var(--bad); background: color-mix(in srgb, var(--bad) 9%, transparent); }
    .cbox.good .ctag { color: var(--ok); background: color-mix(in srgb, var(--ok) 9%, transparent); }
    .cbox pre { margin: 0; padding: 10px 12px; background: var(--panel); overflow-x: auto; font-size: 12.5px;
      font-family: "SF Mono", Consolas, monospace; white-space: pre-wrap; word-break: break-word; }
    .cnote { font-size: 12px; color: var(--muted); font-style: italic; margin: 8px 0 0; }
    .frefs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .frefs a { font-size: 12px; border: 1px solid var(--border); background: var(--panel); border-radius: 999px;
      padding: 3px 11px; text-decoration: none; }
    .frefs a:hover { border-color: var(--accent); text-decoration: none; }
    /* --- Asistente de escaneo paso a paso (wizard) --- */
    ol.wz-steps { display: flex; gap: 8px; margin: 4px 0 22px; padding: 0; list-style: none; }
    ol.wz-steps li { flex: 1; display: flex; align-items: center; gap: 9px; font-size: 12.5px; color: var(--muted);
      padding: 9px 11px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg); }
    ol.wz-steps li .n { width: 22px; height: 22px; border-radius: 50%; background: var(--border); color: var(--muted);
      display: grid; place-items: center; font-size: 12px; font-weight: 700; flex: none; }
    ol.wz-steps li.active { color: var(--ink); border-color: var(--accent); }
    ol.wz-steps li.active .n { background: var(--accent); color: var(--accent-ink); }
    ol.wz-steps li.done { color: var(--ink); }
    ol.wz-steps li.done .n { background: var(--ok); color: #fff; }
    @media (max-width: 720px) { ol.wz-steps li .lbl { display: none; } ol.wz-steps { gap: 6px; } }
    /* progressive enhancement: with JS the form steps; without it, every step is just visible */
    form.wizard.js .wz-step { display: none; }
    form.wizard.js .wz-step.active { display: block; }
    .wz-step > h3 { margin: 0 0 4px; font-size: 15px; }
    .wz-step > .hint { font-size: 12.5px; color: var(--muted); margin: 0 0 14px; }
    .hint { font-size: 12.5px; color: var(--muted); }
    .wz-nav { display: flex; align-items: center; gap: 10px; margin-top: 20px; padding-top: 16px;
      border-top: 1px solid var(--border); }
    button.ghost { background: transparent; color: var(--ink); border: 1px solid var(--border); }
    button.ghost:hover { border-color: var(--accent); filter: none; }
    button[hidden] { display: none; }
    .choices { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 6px 0 4px; }
    @media (max-width: 560px) { .choices { grid-template-columns: 1fr; } }
    label.choice { display: block; position: relative; border: 1px solid var(--border); border-radius: 12px;
      padding: 12px 14px; cursor: pointer; background: var(--bg); margin: 0; color: var(--ink); }
    label.choice input { position: absolute; opacity: 0; width: 0; height: 0; }
    label.choice .t { font-weight: 700; font-size: 14px; }
    label.choice .d { font-size: 12.5px; color: var(--muted); margin-top: 3px; }
    label.choice:has(input:checked) { border-color: var(--accent);
      background: color-mix(in srgb, var(--accent) 7%, transparent); }
    label.choice:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
    ul.recap { list-style: none; margin: 6px 0 0; padding: 0; }
    ul.recap li { display: flex; justify-content: space-between; gap: 12px; padding: 9px 2px;
      border-bottom: 1px solid var(--border); font-size: 14px; }
    ul.recap li span.k { color: var(--muted); }
    details.guide { border: 1px solid var(--border); border-radius: 10px; background: var(--bg);
      margin: 0 0 18px; overflow: hidden; }
    details.guide > summary { cursor: pointer; list-style: none; padding: 11px 14px; font-size: 13.5px;
      font-weight: 600; color: var(--accent); user-select: none; }
    details.guide > summary::-webkit-details-marker { display: none; }
    details.guide[open] > summary { border-bottom: 1px solid var(--border); }
    details.guide .gbody { padding: 12px 16px 16px; font-size: 13.5px; }
    details.guide .gbody ol { margin: 8px 0 0; padding-left: 20px; }
    details.guide .gbody li { margin: 5px 0; }
    /* --- Interpretación de resultados: "empieza por aquí" + estado vacío útil --- */
    .triage-lead { border: 1px solid var(--border); border-left: 3px solid var(--accent); border-radius: 10px;
      background: color-mix(in srgb, var(--accent) 5%, var(--panel)); padding: 12px 15px; margin: 12px 0 16px; }
    .triage-lead.lead-critical { border-left-color: var(--crit); }
    .triage-lead.lead-high { border-left-color: var(--high); }
    .triage-lead.lead-medium { border-left-color: var(--med); }
    .triage-lead.lead-low { border-left-color: var(--low); }
    .triage-lead.lead-info { border-left-color: var(--info); }
    .triage-lead .tl-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 6px; }
    .triage-lead .tl-head strong { font-size: 14px; }
    .triage-lead .sevbar { display: flex; gap: 6px; margin-left: auto; flex-wrap: wrap; }
    .triage-lead p { margin: 0; font-size: 13.5px; }
    .triage-lead .badge[title] { cursor: help; }
    .emptybox { border: 1px solid var(--border); border-radius: 10px; background: var(--bg); padding: 14px 16px; }
    ul.nextsteps { margin: 8px 0 0; padding-left: 20px; }
    ul.nextsteps li { margin: 5px 0; font-size: 13.5px; }
    th[title], td .badge[title] { cursor: help; }
    /* accessibility: visible keyboard focus + respect reduced-motion */
    a:focus-visible, button:focus-visible, summary:focus-visible,
    input:focus-visible, select:focus-visible {
      outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px;
    }
    @media (prefers-reduced-motion: reduce) {
      * { animation-duration: .001ms !important; transition-duration: .001ms !important; }
    }
  </style>
</head>
<body>
  <header class="top">
    <span class="brand">dastcore</span>
    <span class="tag">panel local · DAST</span>
    <span style="margin-left:auto"><a href="/">Escaneos</a> · <a href="/schedules">Programados</a> · <a href="/suppressions">Triaje</a></span>
  </header>
  <main>{% block body %}{% endblock %}</main>
</body>
</html>
