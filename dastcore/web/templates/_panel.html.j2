{% if running %}
  <div class="status st-running">Escaneando…</div>
  <p class="muted">{{ phase }}</p>
  {% if total %}
    <div class="progress"><span style="width: {{ (100 * completed / total) | round(1) }}%"></span></div>
    <p class="muted">{{ completed }} / {{ total }} peticiones</p>
  {% else %}
    <div class="progress"><span style="width: 8%"></span></div>
  {% endif %}
{% elif scan.status == 'error' %}
  <div class="status st-error">Error</div>
  <div class="panel err" style="margin-top:10px">{{ scan.error }}</div>
{% elif scan.status == 'interrupted' %}
  <div class="status st-interrupted">Interrumpido</div>
  <p class="muted">El escaneo no terminó (probablemente el servidor se reinició).</p>
{% elif scan.kind == 'retest' %}
  <div class="status st-done">Reverificación completada</div>
  {% set c = (retest.counts if retest else {}) %}
  <p class="muted">
    <span class="rt-open">abiertos: {{ c.get('open', 0) }}</span> ·
    <span class="rt-fixed">corregidos: {{ c.get('fixed', 0) }}</span> ·
    <span class="rt-unverified">sin verificar: {{ c.get('unverified', 0) }}</span>
    {% if scan.duration_s %}· {{ scan.duration_s | round(1) }}s{% endif %}
    {% if scan.parent_id %}· <a href="/scans/{{ scan.parent_id }}">escaneo original</a>{% endif %}
  </p>
  {% if retest and retest.outcomes %}
  <div class="overflow">
    <table>
      <thead><tr><th>Estado</th><th>Severidad</th><th>Issue</th><th>Ubicación</th></tr></thead>
      <tbody>
        {% for o in retest.outcomes | sort(attribute='status') %}
        <tr>
          <td><span class="rt-{{ o.status }}">
            {{ {'open': 'ABIERTO', 'fixed': 'CORREGIDO', 'unverified': 'SIN VERIFICAR'}[o.status] }}
          </span></td>
          <td><span class="badge sev-{{ o.severity }}">{{ o.severity }}</span></td>
          <td>{{ o.name }}</td>
          <td class="muted">{{ o.location }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
  <div class="actions">
    {% if scan.num_findings %}<a href="/scans/{{ scan.id }}/report" target="_blank">Reporte de abiertos</a>
    <a href="/scans/{{ scan.id }}/findings.json">JSON abiertos</a>
    <a href="/scans/{{ scan.id }}/findings.sarif">SARIF abiertos</a>{% endif %}
  </div>
{% else %}
  {% set SEV_ONE = {'critical':'crítico','high':'alto','medium':'medio','low':'bajo','info':'informativo'} %}
  {% set SEV_MANY = {'critical':'críticos','high':'altos','medium':'medios','low':'bajos','info':'informativos'} %}
  {% set SEV_TIP = {
    'critical':'Crítico — explotable y de alto impacto; corrígelo de inmediato.',
    'high':'Alto — riesgo serio; prioriza su corrección.',
    'medium':'Medio — riesgo moderado; planifica su corrección.',
    'low':'Bajo — riesgo menor.',
    'info':'Informativo — sin impacto directo, para tu conocimiento.'} %}
  <div class="status st-done">Completado</div>
  <p class="muted">
    {{ issues | sum(attribute='count') }} hallazgo(s) activo(s) · {{ issues | length }} issue(s)
    {% if accepted %}· {{ accepted | sum(attribute='count') }} aceptado(s){% endif %}
    {% if scan.duration_s %}· {{ scan.duration_s | round(1) }}s{% endif %}
  </p>
  {% if chains %}
  <div class="chains">
    <div class="chains-head">
      <strong>⛓ Cadenas de explotación ({{ chains | length }})</strong>
      <span class="muted">hallazgos que, combinados, elevan el impacto</span>
    </div>
    {% for c in chains %}
    <div class="chain-card lead-{{ c.severity }}">
      <div class="chain-title">
        <span class="badge sev-{{ c.severity }}">{{ c.severity }}</span>
        <strong>{{ c.name }}</strong>
      </div>
      <p class="chain-summary">{{ c.summary }}</p>
      <ol class="chain-legs">
        {% for leg in c.legs %}
        <li><span class="leg-role">{{ leg.role }}</span>
          <span class="leg-detail">{{ leg.name }} · <code>{{ leg.location }}</code></span></li>
        {% endfor %}
      </ol>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% if issues %}
  {% set top = issues[0] %}
  <div class="triage-lead lead-{{ top.severity }}">
    <div class="tl-head">
      <strong>Empieza por aquí</strong>
      <div class="sevbar">
        {% for sev in ['critical','high','medium','low','info'] %}
          {% set n = issues | selectattr('severity','equalto', sev) | sum(attribute='count') %}
          {% if n %}<span class="badge sev-{{ sev }}" title="{{ SEV_TIP[sev] }}">{{ n }} {{ SEV_MANY[sev] if n > 1 else SEV_ONE[sev] }}</span>{% endif %}
        {% endfor %}
      </div>
    </div>
    <p>
      El hallazgo más grave es <strong>{{ top.name }}</strong> ({{ SEV_ONE[top.severity] }})
      en <code>{{ top.locations[0] }}</code>. Corrígelo primero{% if top.count > 1 %} — se repite en {{ top.count }} ubicaciones{% endif %}.
      <a href="#issue-{{ top.rule_id }}">Ver cómo solucionarlo ↓</a>
    </p>
  </div>
  <div class="overflow">
    <table>
      <thead><tr>
        <th title="Gravedad del hallazgo: de crítico (arréglalo ya) a informativo.">Severidad</th>
        <th title="Gravedad técnica de 0 a 10 según el estándar CVSS 3.1.">CVSS</th>
        <th>Issue</th>
        <th title="Cuántas veces aparece este mismo problema en la aplicación.">Inst.</th>
        <th>Ubicaciones</th>
        <th title="Márcalo como aceptado o falso positivo para sacarlo de la lista activa.">Triaje</th>
      </tr></thead>
      <tbody>
        {% for i in issues %}
        <tr class="issue-row" id="issue-{{ i.rule_id }}">
          <td><span class="badge sev-{{ i.severity }}" title="{{ SEV_TIP[i.severity] }}">{{ i.severity }}</span></td>
          <td>{{ '%.1f' | format(i.cvss_score) }}</td>
          <td>{{ i.name }}</td>
          <td>{{ i.count }}</td>
          <td class="muted">{{ i.locations[:3] | join(', ') }}{% if i.locations | length > 3 %} …{% endif %}</td>
          <td>
            <form method="post" action="/suppress" class="triage">
              <input type="hidden" name="rule_id" value="{{ i.rule_id }}">
              <input type="hidden" name="scan_id" value="{{ scan.id }}">
              <input name="reason" placeholder="motivo (opcional)">
              <button type="submit" title="Marcar como aceptado / falso positivo">Aceptar</button>
            </form>
          </td>
        </tr>
        <tr class="fix-row"><td colspan="6">{% set g = remediation_guide(i) %}
          {% if i.impact %}<p class="impact-proof"><span class="ip-tag">Impacto probado</span>{{ i.impact }}</p>{% endif %}
          <details class="fix">
            <summary>
              <svg class="wr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z"/>
              </svg>Cómo solucionarlo
            </summary>
            <div class="fix-body">
              <p class="fix-sum">{{ g.summary }}</p>
              {% if g.steps %}<ol class="fix-steps">{% for s in g.steps %}<li>{{ s }}</li>{% endfor %}</ol>{% endif %}
              {% if g.example %}
              <div class="code2">
                <div class="cbox bad"><div class="ctag">✗ Vulnerable</div><pre>{{ g.example.bad }}</pre></div>
                <div class="cbox good"><div class="ctag">✓ Seguro</div><pre>{{ g.example.good }}</pre></div>
              </div>
              {% if g.example.note %}<p class="cnote">{{ g.example.note }}</p>{% endif %}
              {% endif %}
              {% if g.references %}
              <div class="frefs">
                {% for r in g.references %}<a href="{{ r.url }}" target="_blank" rel="noopener noreferrer">{{ r.label }} ↗</a>{% endfor %}
              </div>
              {% endif %}
            </div>
          </details>
        </td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% elif accepted %}
    <div class="emptybox">
      <p style="margin:0 0 4px"><strong>Sin hallazgos activos.</strong></p>
      <p class="muted" style="margin:0">Todo lo detectado está triado como aceptado / falso positivo (abajo).
        Puedes revisarlo o exportarlo en <a href="/suppressions">Triaje</a>.</p>
    </div>
  {% else %}
    <div class="emptybox">
      <p style="font-size:15px; margin:0 0 6px">✅ <strong>Sin hallazgos en este escaneo.</strong></p>
      <p class="muted" style="margin:0">dastcore no confirmó ninguna vulnerabilidad en lo que pudo alcanzar.
        Para asegurarte de cubrir toda la aplicación, prueba a reejecutar así:</p>
      <ul class="nextsteps">
        <li>¿La app requiere iniciar sesión? Añade un <strong>token o cookie</strong> en el paso «Acceso»
          para que el escáner cubra las zonas privadas.</li>
        <li>¿Es una SPA (React/Vue/Angular)? Cambia el motor a <strong>Navegador</strong> para que descubra
          las rutas que se cargan con JavaScript.</li>
        <li>Sube al perfil <strong>Completo</strong> para incluir las comprobaciones más intrusivas.</li>
      </ul>
    </div>
  {% endif %}
  {% if accepted %}
  <div class="accepted">
    <strong class="muted">Aceptados / falsos positivos ({{ accepted | length }})</strong>
    <div class="overflow">
      <table>
        <thead><tr><th>Severidad</th><th>Issue</th><th>Inst.</th></tr></thead>
        <tbody>
          {% for i in accepted %}
          <tr>
            <td><span class="badge sev-{{ i.severity }}">{{ i.severity }}</span></td>
            <td class="muted">{{ i.name }}</td>
            <td class="muted">{{ i.count }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="muted" style="font-size:13px">Gestiona o exporta a <code>.dastcore-ignore</code> en <a href="/suppressions">Triaje</a>.</p>
  </div>
  {% endif %}
  <div class="actions">
    {% if issues %}<a href="/scans/{{ scan.id }}/bounty"><strong>Crear informe para reportar</strong></a>{% endif %}
    <a href="/scans/{{ scan.id }}/report" target="_blank">Ver reporte HTML</a>
    <a href="/scans/{{ scan.id }}/findings.json">Descargar JSON</a>
    <a href="/scans/{{ scan.id }}/findings.sarif">Descargar SARIF</a>
  </div>
  {% if scan.num_findings %}
  <form class="subform" method="post" action="/scans/{{ scan.id }}/retest">
    <strong>Reverificar</strong>
    <span class="muted">— re-lanza solo estas peticiones para ver qué sigue vivo y qué se corrigió.</span>
    <div class="row">
      <div><label for="rt_bearer">Bearer token (opcional)</label>
        <input id="rt_bearer" name="auth_bearer" placeholder="eyJ…"></div>
      <div><label for="rt_cookie">Cookie (opcional)</label>
        <input id="rt_cookie" name="auth_cookie" placeholder="sid=abc123"></div>
    </div>
    <div class="check">
      <input id="rt_auth" name="authorization" type="checkbox" value="on">
      <label for="rt_auth" style="margin:0">Tengo autorización para reverificar este objetivo.</label>
    </div>
    <button type="submit">Reverificar hallazgos</button>
  </form>
  {% endif %}
{% endif %}
