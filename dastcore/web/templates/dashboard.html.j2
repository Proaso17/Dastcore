{% extends "base.html.j2" %}
{% block title %}dastcore · escaneos{% endblock %}
{% block body %}
  <div class="panel legal">
    Herramienta de pentesting <strong>activa e intrusiva</strong>. Úsala solo contra sistemas para los que
    tienes autorización explícita y por escrito. El escaneo no arranca sin marcar la casilla de autorización.
  </div>

  <div class="panel">
    <h2>Nuevo escaneo</h2>
    {% if error %}<div class="panel err" style="margin:0 0 14px">{{ error }}</div>{% endif %}
    <form method="post" action="/scans">
      <label for="mode">Tipo de escaneo</label>
      <select id="mode" name="mode" onchange="dcToggleMode(this.value)">
        <option value="scan">Web (vulnerabilidades clásicas)</option>
        <option value="ai">Chatbot embebido (IA / OWASP LLM)</option>
      </select>

      <label for="target">URL objetivo</label>
      <input id="target" name="target" placeholder="https://staging.example.com" value="{{ target or '' }}" required>

      <div class="row3" data-mode="scan">
        <div>
          <label for="engine">Motor</label>
          <select id="engine" name="engine">
            <option value="http">http (estático)</option>
            <option value="headless">headless (SPA)</option>
            <option value="both">both</option>
          </select>
        </div>
        <div>
          <label for="profile">Perfil</label>
          <select id="profile" name="profile">
            <option value="">(personalizado)</option>
            <option value="quick">quick</option>
            <option value="full">full</option>
            <option value="api">api</option>
          </select>
        </div>
        <div>
          <label for="rps">Requests/segundo</label>
          <input id="rps" name="rps" type="number" step="0.5" min="0.5" value="5">
        </div>
      </div>

      <div class="row">
        <div>
          <label for="auth_bearer">Bearer token (opcional)</label>
          <input id="auth_bearer" name="auth_bearer" placeholder="eyJ…">
        </div>
        <div data-mode="scan">
          <label for="auth_cookie">Cookie (opcional)</label>
          <input id="auth_cookie" name="auth_cookie" placeholder="sid=abc123">
        </div>
      </div>

      <div data-mode="ai" hidden>
        <p class="muted" style="margin:6px 0 10px">
          Crawlea la app, autodetecta el endpoint del chatbot y corre las comprobaciones OWASP LLM
          (prompt injection, inyección almacenada). Para las pruebas <strong>cross-tenant</strong>
          (BOLA/BFLA vía el asistente) añade una segunda identidad:
        </p>
        <div class="row">
          <div>
            <label for="victim_bearer">Bearer de un 2.º tenant (víctima)</label>
            <input id="victim_bearer" name="victim_bearer" placeholder="eyJ… (otra cuenta)">
          </div>
          <div>
            <label for="victim_ref">Cómo nombrar a la víctima (una por línea)</label>
            <textarea id="victim_ref" name="victim_ref" rows="2" placeholder="unit 4B&#10;bob"></textarea>
          </div>
        </div>
      </div>

      <div class="check">
        <input id="authorization" name="authorization" type="checkbox" value="on">
        <label for="authorization" style="margin:0">Tengo autorización explícita para escanear este objetivo.</label>
      </div>
      <button type="submit">Iniciar escaneo</button>
    </form>
    <script>
      function dcToggleMode(mode) {
        document.querySelectorAll('[data-mode]').forEach(function (el) {
          el.hidden = el.getAttribute('data-mode') !== mode;
        });
      }
      dcToggleMode(document.getElementById('mode').value);
    </script>
  </div>

  <div class="panel">
    <h2>Historial</h2>
    {% if scans %}
    <div class="overflow">
      <table>
        <thead><tr><th>Objetivo</th><th>Motor</th><th>Estado</th><th>Hallazgos</th><th>Cuándo</th></tr></thead>
        <tbody>
          {% for s in scans %}
          <tr>
            <td>
              {% if s.kind == 'retest' %}<span class="muted" title="reverificación">↻</span> {% endif %}
              <a href="/scans/{{ s.id }}">{{ s.target }}</a>
            </td>
            <td class="muted">{% if s.kind == 'retest' %}retest{% elif s.kind == 'ai' %}chatbot IA{% else %}{{ s.engine }}{% if s.profile %} · {{ s.profile }}{% endif %}{% endif %}</td>
            <td><span class="status st-{{ s.status }}">{{ s.status }}</span></td>
            <td>
              {% if s.status == 'done' %}
                <strong>{{ s.num_findings }}</strong>
                {% for sev in ['critical','high','medium','low'] %}
                  {% if s.severity_counts.get(sev) %}<span class="badge sev-{{ sev }}">{{ s.severity_counts[sev] }}</span>{% endif %}
                {% endfor %}
                {% if s.accepted %}<span class="muted" title="ocultos por triaje">· {{ s.accepted }} aceptado(s)</span>{% endif %}
              {% else %}<span class="muted">—</span>{% endif %}
            </td>
            <td class="muted">{{ s.created_at | datetime }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
      <div class="empty">Aún no hay escaneos. Lanza el primero arriba.</div>
    {% endif %}
  </div>
{% endblock %}
