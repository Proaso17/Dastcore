{% extends "base.html.j2" %}
{% block title %}dastcore · programados{% endblock %}
{% block body %}
  <div class="panel legal">
    Los escaneos programados son <strong>activos e intrusivos</strong> y se lanzan sin supervisión.
    Prográmalos solo contra objetivos para los que tienes autorización permanente.
  </div>

  <details class="guide" style="max-width:1080px;margin:0 auto 20px">
    <summary>Guía rápida · escaneos automáticos</summary>
    <div class="gbody">
      <p style="margin:0">Un escaneo programado <strong>repite un escaneo cada cierto tiempo</strong>, sin que
        tengas que lanzarlo a mano. Es útil para:</p>
      <ol style="list-style:disc">
        <li>Vigilar un entorno de staging (p. ej. cada noche) y detectar regresiones pronto.</li>
        <li>Mantener una línea base estable para tu CI/CD.</li>
      </ol>
      <p style="margin:10px 0 0">Como se ejecuta solo, necesita <strong>autorización permanente</strong> sobre el
        objetivo. En cada fila puedes <strong>Ejecutar</strong> ahora, <strong>Pausar/Reanudar</strong> o
        <strong>Borrar</strong> el programado.</p>
    </div>
  </details>

  <div class="panel">
    <h2>Escaneos programados ({{ schedules | length }})</h2>
    {% if schedules %}
    <div class="overflow">
      <table>
        <thead><tr>
          <th title="URL que se escaneará.">Objetivo</th>
          <th title="Motor de escaneo: rápido (HTML) o navegador (SPAs).">Motor</th>
          <th title="Cada cuánto se repite el escaneo.">Cada</th>
          <th title="Activo = se ejecuta automáticamente; pausado = no.">Estado</th>
          <th title="Cuándo se ejecutó por última vez.">Última</th>
          <th title="Cuándo se ejecutará la próxima vez.">Próxima</th>
          <th></th>
        </tr></thead>
        <tbody>
          {% for s in schedules %}
          <tr>
            <td style="word-break:break-all">{{ s.target }}</td>
            <td class="muted">{{ s.engine }}{% if s.profile %} · {{ s.profile }}{% endif %}</td>
            <td class="muted">
              {% set mins = s.interval_minutes %}
              {% if mins % 1440 == 0 %}{{ mins // 1440 }} día(s){% elif mins % 60 == 0 %}{{ mins // 60 }} h{% else %}{{ mins }} min{% endif %}
            </td>
            <td><span class="status {{ 'st-done' if s.enabled else 'st-interrupted' }}">{{ 'activo' if s.enabled else 'pausado' }}</span></td>
            <td class="muted">{{ (s.last_run_at | datetime) if s.last_run_at else '—' }}</td>
            <td class="muted">{{ s.next_run_at | datetime }}</td>
            <td>
              <div style="display:flex; gap:6px">
                <form method="post" action="/schedules/{{ s.id }}/run" style="margin:0">
                  <button type="submit" style="padding:5px 10px;font-size:12px">Ejecutar</button>
                </form>
                <form method="post" action="/schedules/{{ s.id }}/toggle" style="margin:0">
                  <button type="submit" style="padding:5px 10px;font-size:12px">{{ 'Pausar' if s.enabled else 'Reanudar' }}</button>
                </form>
                <form method="post" action="/schedules/{{ s.id }}/delete" style="margin:0">
                  <button type="submit" class="danger" style="padding:5px 10px;font-size:12px">Borrar</button>
                </form>
              </div>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
      <div class="empty">Sin escaneos programados. Crea uno abajo.</div>
    {% endif %}
  </div>

  <div class="panel">
    {% set al = alerts %}
    {% set curfmt = al.fmt if al else 'slack' %}
    {% set cursev = al.min_severity if al else 'medium' %}
    <h2>Alertas — avísame solo cuando aparezca algo nuevo</h2>
    {% if saved %}<div class="panel" style="margin:0 0 12px;border-left:3px solid #2d7">Configuración de alertas guardada.</div>{% endif %}
    <p class="hint" style="margin:0 0 10px">Tras cada escaneo (programado o manual), dastcore compara con el escaneo
      anterior del mismo objetivo y, si hay hallazgos <strong>nuevos</strong> por encima del umbral, envía un aviso a tu
      webhook. Ideal para vigilancia continua: prográmalo arriba y entérate solo cuando cambie algo.</p>
    <form method="post" action="/alerts">
      <label for="webhook_url">Webhook</label>
      <input id="webhook_url" name="webhook_url" placeholder="https://hooks.slack.com/services/…  ·  https://discord.com/api/webhooks/…"
             value="{{ al.webhook_url if al else '' }}">
      <p class="hint" style="margin:5px 0 0"><b>De dónde sacarlo:</b> <em>Slack</em> → app "Incoming Webhooks" → Add to Slack → copia la URL.
        <em>Discord</em> → Editar canal → Integraciones → Webhooks → Nuevo webhook → Copiar URL. O cualquier endpoint propio (formato «genérico», JSON).</p>
      <div class="row" style="margin-top:12px">
        <div>
          <label for="fmt">Formato</label>
          <select id="fmt" name="fmt">
            <option value="slack" {% if curfmt == 'slack' %}selected{% endif %}>Slack</option>
            <option value="discord" {% if curfmt == 'discord' %}selected{% endif %}>Discord</option>
            <option value="generic" {% if curfmt == 'generic' %}selected{% endif %}>Genérico (JSON)</option>
          </select>
        </div>
        <div>
          <label for="min_severity">Umbral mínimo</label>
          <select id="min_severity" name="min_severity">
            {% for sev in ['critical', 'high', 'medium', 'low', 'info'] %}
            <option value="{{ sev }}" {% if cursev == sev %}selected{% endif %}>{{ sev }}</option>
            {% endfor %}
          </select>
        </div>
      </div>
      <div class="check" style="margin-top:12px">
        <input id="alerts_enabled" name="enabled" type="checkbox" value="on" {% if al and al.enabled %}checked{% endif %}>
        <label for="alerts_enabled" style="margin:0">Activar alertas de hallazgos nuevos</label>
      </div>
      <button type="submit" style="margin-top:6px">Guardar alertas</button>
    </form>
  </div>

  <div class="panel">
    <h2>Nuevo programado</h2>
    {% if error %}<div class="panel err" style="margin:0 0 14px">{{ error }}</div>{% endif %}
    <form method="post" action="/schedules">
      <label for="target">URL objetivo</label>
      <input id="target" name="target" placeholder="https://staging.example.com" required>
      <div class="row3">
        <div>
          <label for="engine">Motor</label>
          <select id="engine" name="engine">
            <option value="http">Rápido (HTML estático)</option>
            <option value="headless">Navegador (SPAs React/Vue/Angular)</option>
            <option value="both">Ambos</option>
          </select>
        </div>
        <div>
          <label for="profile">Profundidad</label>
          <select id="profile" name="profile">
            <option value="">Personalizado</option>
            <option value="quick">Rápido</option>
            <option value="full">Completo</option>
            <option value="api">API</option>
          </select>
        </div>
        <div>
          <label for="interval_minutes">Cada cuánto se repite</label>
          <select id="interval_minutes" name="interval_minutes">
            {% for mins, label in intervals %}
            <option value="{{ mins }}" {% if mins == 1440 %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </select>
        </div>
      </div>
      <p class="hint" style="margin:6px 0 0">Usa «Navegador» solo si la web se construye con JavaScript. Para
        vigilar regresiones cada noche, «Completo» + «diario» es una buena combinación.</p>
      <div class="row">
        <div><label for="auth_bearer">Token Bearer (opcional)</label><input id="auth_bearer" name="auth_bearer" placeholder="eyJ…"></div>
        <div><label for="auth_cookie">Cookie de sesión (opcional)</label><input id="auth_cookie" name="auth_cookie" placeholder="sid=abc123"></div>
      </div>
      <p class="hint" style="margin:6px 0 0">Rellénalos si el objetivo requiere login, para que el escaneo
        automático cubra también las zonas privadas.</p>
      <div class="check">
        <input id="authorization" name="authorization" type="checkbox" value="on">
        <label for="authorization" style="margin:0">Tengo autorización permanente para escanear este objetivo.</label>
      </div>
      <button type="submit">Programar</button>
    </form>
  </div>
{% endblock %}
