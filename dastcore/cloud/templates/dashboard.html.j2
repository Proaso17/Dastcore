{% extends "base.html.j2" %}
{% block title %}dastcore cloud · {{ project.name }}{% endblock %}
{% block nav %}
  <span class="nav muted">
    proyecto <strong>{{ project.name }}</strong>
    · <form method="post" action="/ui/regenerate-key" style="display:inline"
        onsubmit="return confirm('¿Generar una nueva API key? La actual dejará de funcionar en tus runners.')"><button class="small" type="submit">Regenerar API key</button></form>
    · <form method="post" action="/ui/logout" style="display:inline"><button class="small" type="submit">Salir</button></form>
  </span>
{% endblock %}
{% block body %}
  {% if new_api_key %}
  <div class="panel flash">
    <strong>Nueva API key.</strong> La anterior ya no funciona. Guárdala (se muestra solo una vez):
    <div style="margin-top:8px"><code>{{ new_api_key }}</code></div>
  </div>
  {% endif %}
  {% if new_runner_token %}
  <div class="panel flash">
    <strong>Runner creado.</strong> Guarda su token (se muestra solo una vez):
    <div style="margin-top:8px"><code>{{ new_runner_token }}</code></div>
    <div class="muted" style="font-size:13px; margin-top:8px">
      Arráncalo en la red del objetivo:
      <code>dastcore runner &lt;URL&gt; --token {{ new_runner_token }} --i-have-authorization</code>
    </div>
  </div>
  {% endif %}

  <div class="panel">
    <h2>Encolar escaneo</h2>
    <form method="post" action="/ui/jobs">
      <label for="mode">Tipo</label>
      <select id="mode" name="mode" onchange="cpToggleMode(this.value)">
        <option value="scan">Web (vulnerabilidades clásicas)</option>
        <option value="ai">Chatbot embebido (IA / OWASP LLM)</option>
      </select>
      <label for="target">URL objetivo</label>
      <input id="target" name="target" placeholder="https://staging.example.com" required>
      <div class="row3" data-mode="scan">
        <div><label for="engine">Motor</label>
          <select id="engine" name="engine"><option value="http">http</option><option value="headless">headless</option><option value="both">both</option></select></div>
        <div><label for="profile">Perfil</label>
          <select id="profile" name="profile"><option value="">(personalizado)</option><option value="quick">quick</option><option value="full">full</option><option value="api">api</option></select></div>
        <div style="display:flex; align-items:flex-end"><button type="submit" style="width:100%">Encolar</button></div>
      </div>
      <div class="row3" data-mode="ai" hidden>
        <div><label for="auth_bearer">Bearer (tenant)</label><input id="auth_bearer" name="auth_bearer" placeholder="eyJ…"></div>
        <div><label for="victim_bearer">Bearer víctima (2.º tenant)</label><input id="victim_bearer" name="victim_bearer" placeholder="eyJ… (opcional)"></div>
        <div style="display:flex; align-items:flex-end"><button type="submit" style="width:100%">Encolar</button></div>
      </div>
      <div data-mode="ai" hidden>
        <label for="victim_ref">Cómo nombrar a la víctima (una por línea)</label>
        <textarea id="victim_ref" name="victim_ref" rows="2" placeholder="unit 4B&#10;bob"></textarea>
      </div>
    </form>
    <script>
      function cpToggleMode(mode) {
        document.querySelectorAll('[data-mode]').forEach(function (el) { el.hidden = el.getAttribute('data-mode') !== mode; });
      }
      cpToggleMode(document.getElementById('mode').value);
    </script>
  </div>

  <div class="panel">
    <h2>Trabajos ({{ jobs | length }})</h2>
    {% set ns = namespace(active=false) %}
    {% for j in jobs %}{% if j.status in ['queued', 'running'] %}{% set ns.active = true %}{% endif %}{% endfor %}
    {% if ns.active %}
    <p class="muted" style="margin:0 0 12px; font-size:13px">
      <span class="spin"></span> Hay trabajos en curso. Esta página se actualiza sola cada pocos segundos.
    </p>
    <script>setTimeout(function () { location.reload(); }, 6000);</script>
    {% endif %}
    {% if jobs %}
    <div class="overflow"><table>
      <thead><tr><th>Objetivo</th><th>Motor</th><th>Estado</th><th>Runner</th><th>Hallazgos</th><th>Creado</th></tr></thead>
      <tbody>
        {% for j in jobs %}
        <tr>
          <td><a href="/ui/jobs/{{ j.id }}">{{ j.target }}</a></td>
          <td class="muted">{{ j.engine }}{% if j.profile %} · {{ j.profile }}{% endif %}</td>
          <td><span class="st-{{ j.status }}">{{ j.status }}</span></td>
          <td class="muted">{{ j.runner or '—' }}</td>
          <td>{% if j.status == 'done' %}<strong>{{ j.num_findings }}</strong>
              {% for sev in ['critical','high','medium','low'] %}{% if j.severity_counts.get(sev) %}<span class="badge sev-{{ sev }}">{{ j.severity_counts[sev] }}</span>{% endif %}{% endfor %}
              {% else %}<span class="muted">—</span>{% endif %}</td>
          <td class="muted">{{ j.created_at | datetime }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table></div>
    {% else %}<div class="empty">Aún no has lanzado ningún escaneo. Rellena el formulario de arriba y pulsa «Encolar» para empezar.</div>{% endif %}
  </div>

  {% if trends %}
  <div class="panel">
    <h2>Tendencias por objetivo</h2>
    <p class="muted">Hallazgos por escaneo a lo largo del tiempo. La flecha compara el último escaneo con el anterior.</p>
    <div class="overflow"><table>
      <thead><tr><th>Objetivo</th><th>Escaneos</th><th>Últimos hallazgos</th><th>Δ</th><th>Tendencia</th></tr></thead>
      <tbody>
        {% for t in trends %}
        <tr>
          <td>{{ t.target }}</td>
          <td class="muted">{{ t.scans }}</td>
          <td><strong>{{ t.latest }}</strong>
            {% for sev in ['critical','high','medium','low'] %}{% if t.severity_counts.get(sev) %}<span class="badge sev-{{ sev }}">{{ t.severity_counts[sev] }}</span>{% endif %}{% endfor %}</td>
          <td>{% if t.delta is none %}<span class="muted">—</span>
              {% elif t.delta > 0 %}<span class="delta-up">▲ +{{ t.delta }}</span>
              {% elif t.delta < 0 %}<span class="delta-down">▼ {{ t.delta }}</span>
              {% else %}<span class="muted">= 0</span>{% endif %}</td>
          <td><svg width="130" height="30" viewBox="0 0 130 30" preserveAspectRatio="none" aria-label="tendencia">
              <polyline fill="none" stroke="currentColor" stroke-width="1.5" points="{{ t.sparkline }}"/>
            </svg></td>
        </tr>
        {% endfor %}
      </tbody>
    </table></div>
  </div>
  {% endif %}

  <div class="panel">
    <h2>Runners ({{ runners | length }})</h2>
    {% if runners %}
    <div class="overflow"><table>
      <thead><tr><th>Nombre</th><th>Creado</th><th>Última vez</th></tr></thead>
      <tbody>{% for r in runners %}<tr><td>{{ r.name }}</td><td class="muted">{{ r.created_at | datetime }}</td><td class="muted">{{ r.last_seen_at | datetime }}</td></tr>{% endfor %}</tbody>
    </table></div>
    {% else %}<div class="empty">Todavía no hay runners. Un runner es el programa que ejecutas en tu red y que realiza los escaneos; crea uno abajo para poder procesar los trabajos.</div>{% endif %}
    <form method="post" action="/ui/runners" style="display:flex; gap:10px; align-items:flex-end; margin-top:12px">
      <div style="flex:1"><label for="rname">Nuevo runner (nombre)</label><input id="rname" name="name" placeholder="runner-staging"></div>
      <button type="submit">Crear token</button>
    </form>
  </div>

  <div class="panel">
    <h2>Programados ({{ schedules | length }})</h2>
    {% if schedules %}
    <div class="overflow"><table>
      <thead><tr><th>Objetivo</th><th>Cada</th><th>Estado</th><th>Próxima</th><th></th></tr></thead>
      <tbody>
        {% for s in schedules %}
        <tr>
          <td>{{ s.target }}</td>
          <td class="muted">{% set m = s.interval_minutes %}{% if m % 1440 == 0 %}{{ m // 1440 }} día(s){% elif m % 60 == 0 %}{{ m // 60 }} h{% else %}{{ m }} min{% endif %}</td>
          <td><span class="{{ 'st-done' if s.enabled else 'st-error' }}">{{ 'activo' if s.enabled else 'pausado' }}</span></td>
          <td class="muted">{{ s.next_run_at | datetime }}</td>
          <td><div style="display:flex; gap:6px">
            <form method="post" action="/ui/schedules/{{ s.id }}/toggle"><button class="small" type="submit">{{ 'Pausar' if s.enabled else 'Reanudar' }}</button></form>
            <form method="post" action="/ui/schedules/{{ s.id }}/delete"><button class="small danger" type="submit">Borrar</button></form>
          </div></td>
        </tr>
        {% endfor %}
      </tbody>
    </table></div>
    {% else %}<div class="empty">No hay escaneos programados. Programa uno abajo para que se repita solo (por ejemplo, cada noche) sin que tengas que lanzarlo a mano.</div>{% endif %}
    <form method="post" action="/ui/schedules" style="margin-top:12px">
      <div class="row3">
        <div><label for="starget">Objetivo</label><input id="starget" name="target" placeholder="https://staging.example.com" required></div>
        <div><label for="sengine">Motor</label><select id="sengine" name="engine"><option value="http">http</option><option value="headless">headless</option><option value="both">both</option></select></div>
        <div><label for="sinterval">Frecuencia</label><select id="sinterval" name="interval_minutes">{% for m, label in intervals %}<option value="{{ m }}" {% if m == 1440 %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>
      </div>
      <button type="submit">Programar</button>
    </form>
  </div>

  <div class="panel">
    <h2>Alertas de regresión</h2>
    <p class="muted">Avisa a un webhook (Slack u otro) cuando un escaneo encuentra hallazgos <strong>nuevos</strong> respecto al escaneo anterior del mismo objetivo. Solo se notifican regresiones, no la deuda ya conocida.</p>
    <form method="post" action="/ui/notifications" style="margin-top:12px">
      <div><label for="whook">Webhook URL <span class="muted">(vacío para desactivar)</span></label>
        <input id="whook" name="webhook_url" placeholder="https://hooks.slack.com/services/…" value="{{ notification.webhook_url if notification else '' }}"></div>
      <div class="row3" style="margin-top:10px">
        <div><label for="won">Disparador</label><select id="won" name="notify_on">
          <option value="regression" {% if (notification.notify_on if notification else 'regression') == 'regression' %}selected{% endif %}>Solo regresiones</option>
          <option value="any" {% if notification and notification.notify_on == 'any' %}selected{% endif %}>Cualquier escaneo</option>
        </select></div>
        <div><label for="wformat">Formato</label><select id="wformat" name="format">
          <option value="slack" {% if notification and notification.format == 'slack' %}selected{% endif %}>Slack</option>
          <option value="generic" {% if notification and notification.format == 'generic' %}selected{% endif %}>Genérico (JSON)</option>
        </select></div>
        <div><label for="wsev">Severidad mínima</label><select id="wsev" name="min_severity">
          {% for sev in ['critical','high','medium','low','info'] %}
          <option value="{{ sev }}" {% if (notification.min_severity if notification else 'high') == sev %}selected{% endif %}>{{ sev }}</option>
          {% endfor %}
        </select></div>
      </div>
      <button type="submit" style="margin-top:10px">Guardar</button>
    </form>
  </div>
{% endblock %}
